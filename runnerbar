#!/usr/bin/env bash
# runnerbar — single entry point for RunnerBar runner administration.
#
#   ./runnerbar add                        interactive registration (run inside
#                                          a repo checkout to infer owner/name)
#   ./runnerbar add --repo o/n --replicas 3
#   ./runnerbar register --repo o/n ...    non-interactive, all flags
#   ./runnerbar list                       config entries + GitHub online status
#   ./runnerbar config                     print ~/.runnerbar/config.json
#
# RunnerBar.app is the monitoring UI; these commands are the headless path for
# registering and inspecting repo runners.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CONFIG_PATH="${RUNNERBAR_CONFIG:-$HOME/.runnerbar/config.json}"
die() { echo "error: $*" >&2; exit 1; }

usage() { sed -n '2,11p' "$0"; }

cmd_list() {
  /usr/bin/python3 - "$CONFIG_PATH" <<'PY'
import json, subprocess, sys
try:
    config = json.load(open(sys.argv[1], encoding="utf-8"))
except FileNotFoundError:
    sys.exit("no config at " + sys.argv[1])
for r in config.get("runners", []):
    owner_repo = f"{r['owner']}/{r['repo']}"
    try:
        out = subprocess.run(
            ["gh", "api", f"repos/{owner_repo}/actions/runners", "--jq",
             ".runners[] | .name + \" \" + .status"],
            capture_output=True, text=True, check=True).stdout.split()
        status = dict(zip(out[::2], out[1::2]))
    except Exception as e:
        status = {}
    print(f"{r['displayName']}  ({r.get('mode','service')}, labels: {','.join(r.get('labels',[]))})")
    for i in range(1, (r.get("replicas") or 1) + 1):
        name = r["runnerName"] if i == 1 else f"{r['runnerName']}-{i}"
        print(f"  {i}. {name:<24} {status.get(name, '-'):<8} {r['runnerPath'] if i==1 else r['runnerPath']+'-'+str(i)}")
PY
}

case "${1:-help}" in
  add)      shift; exec "$ROOT/scripts/add-runner.sh" "$@" ;;
  register) shift; exec "$ROOT/scripts/register-repo-runner.sh" "$@" ;;
  list)     cmd_list ;;
  config)   cat "$CONFIG_PATH" ;;
  -h|--help|help) usage ;;
  *)        die "unknown command: $1 (try: add, register, list, config)" ;;
esac
